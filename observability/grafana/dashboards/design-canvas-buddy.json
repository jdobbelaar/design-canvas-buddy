{
  "uid": "design-canvas-buddy",
  "title": "Design Canvas Buddy",
  "tags": [
    "design-canvas-buddy"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_active_requests, deployment_environment_name)",
          "refId": "environment"
        },
        "definition": "label_values(http_server_active_requests, deployment_environment_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_active_requests{deployment_environment_name=~\"$environment\"}, service_version)",
          "refId": "version"
        },
        "definition": "label_values(http_server_active_requests{deployment_environment_name=~\"$environment\"}, service_version)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_duration_milliseconds_count{deployment_environment_name=~\"$environment\", service_version=~\"$version\"}[$__rate_interval]))",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Server errors (5xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_duration_milliseconds_count{deployment_environment_name=~\"$environment\", service_version=~\"$version\", http_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_duration_milliseconds_count{deployment_environment_name=~\"$environment\", service_version=~\"$version\"}[$__rate_interval]))",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Versions reporting",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Which deployed version(s) of each environment sent metrics in the selected time range.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "group by (deployment_environment_name, service_version) (http_server_active_requests{deployment_environment_name=~\"$environment\", service_version=~\"$version\"})",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {
              "deployment_environment_name": "Environment",
              "service_version": "Version"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Interview activity",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Rooms, elements and failures are rates (per minute, left axis). Active participants is how many people are connected right now (right axis). Filtered by the Environment and Version selectors above. \"Component\" failures are elements that could not be created: an invalid message, an id that belongs to another room, or a server error.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(interview_rooms_created_total{deployment_environment_name=~\"$environment\", service_version=~\"$version\"}[$__rate_interval])) or vector(0)) * 60",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "Rooms created / min"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(canvas_elements_created_total{deployment_environment_name=~\"$environment\", service_version=~\"$version\"}[$__rate_interval])) or vector(0)) * 60",
          "refId": "B",
          "editorMode": "code",
          "legendFormat": "Elements created / min"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(canvas_element_creation_failures_total{deployment_environment_name=~\"$environment\", service_version=~\"$version\"}[$__rate_interval])) or vector(0)) * 60",
          "refId": "C",
          "editorMode": "code",
          "legendFormat": "Component creation failures / min"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(interview_participants_active{deployment_environment_name=~\"$environment\", service_version=~\"$version\"}) or vector(0)",
          "refId": "D",
          "editorMode": "code",
          "legendFormat": "Active participants"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Active participants"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Component creation failures / min"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests per second by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_status_code) (rate(http_server_duration_milliseconds_count{deployment_environment_name=~\"$environment\", service_version=~\"$version\"}[$__rate_interval]))",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "{{http_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 15
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request latency (p50 / p95 / p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_duration_milliseconds_bucket{deployment_environment_name=~\"$environment\", service_version=~\"$version\"}[$__rate_interval])))",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket{deployment_environment_name=~\"$environment\", service_version=~\"$version\"}[$__rate_interval])))",
          "refId": "B",
          "editorMode": "code",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_milliseconds_bucket{deployment_environment_name=~\"$environment\", service_version=~\"$version\"}[$__rate_interval])))",
          "refId": "C",
          "editorMode": "code",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Click a trace ID to open it; from a span you can jump to that trace's logs.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{resource.service.name=\"design-canvas-buddy\" && resource.deployment.environment.name=~\"$environment\" && resource.service.version=~\"$version\"}"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Each line links to its trace.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "range",
          "editorMode": "code",
          "expr": "{service_name=\"design-canvas-buddy\", deployment_environment_name=~\"$environment\"} | service_version=~\"$version\""
        }
      ]
    }
  ]
}
