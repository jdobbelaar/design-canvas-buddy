# SQLAlchemy async database URL. Defaults to a local SQLite file
# (./app.db) if unset. Copy this file to .env and adjust if needed.
#
# SQLite (default):
#   DATABASE_URL=sqlite+aiosqlite:///./app.db
#
# Postgres (once psycopg/asyncpg is added as a dependency):
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/design_canvas_buddy
DATABASE_URL=sqlite+aiosqlite:///./app.db
