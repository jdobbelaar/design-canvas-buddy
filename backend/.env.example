# Database connection URL. Defaults to a local SQLite file (./app.db) if
# unset. Copy this file to .env and adjust if needed. The async driver is
# chosen for you from the scheme, and an explicit "+driver" is respected.
#
# SQLite (default):
#   DATABASE_URL=sqlite+aiosqlite:///./app.db
#
# Postgres -- any of these forms work, including the bare postgres:// URL that
# Heroku/Neon/RDS/etc. hand you, and libpq's ?sslmode=require. Percent-encode
# special characters in the password. The database must already exist; the
# tables are created on startup.
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/design_canvas_buddy
#   DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Running the test suite against Postgres instead of in-memory SQLite (see
# tests/conftest.py). Use a throwaway database: the tests drop every table, so
# the database name must contain "test".
#   TEST_DATABASE_URL=postgresql+asyncpg://postgres:test@localhost:55432/dcb_test
